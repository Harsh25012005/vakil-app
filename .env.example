# Copy to .env. Values come from Supabase Dashboard > Project Settings > API Keys.
# Use the publishable key (sb_publishable_...). Never put the secret key in the app:
# every EXPO_PUBLIC_ variable is bundled into the client.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...

# Google sign-in. Web client ID: the OAuth client of type "Web application" set on the Supabase Google provider.
# iOS client ID: only for iOS builds. Client IDs are not secrets; the client secret goes only in the Supabase dashboard.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
