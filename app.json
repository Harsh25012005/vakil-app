{
  "expo": {
    "name": "Vakil",
    "slug": "vakil-app",
    "scheme": "vakil",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      "expo-notifications",
      "expo-sharing",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "app.vakil",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "ios": {
      "bundleIdentifier": "app.vakil"
    },
    "web": {
      "name": "Vakil",
      "shortName": "Vakil",
      "favicon": "./assets/images/favicon.png",
      "themeColor": "#1758FD",
      "backgroundColor": "#FFFFFF"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a18ba9c9-0b2c-4a8c-a85b-1b1a753fbee4"
      }
    }
  }
}
